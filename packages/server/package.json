    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dev-env/core": "workspace:*",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "open": "^10.2.0",
    "yaml": "^2.8.1"
  }
}
