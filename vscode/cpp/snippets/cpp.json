{
  "main": {
    "prefix": "main",
    "body": ["#include <iostream>", "", "int main() {", "    ${1:std::cout << \"Hello, world!\\n\";}", "    return 0;", "}"],
    "description": "C++ main function"
  },
  "class": {
    "prefix": "class",
    "body": ["class ${1:Name} {", "public:", "    ${1:Name}() = default;", "    ~${1:Name}() = default;", "", "private:", "    ${2:// members}", "};"],
    "description": "C++ class skeleton"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "    ${2:int value = 0;}", "};"],
    "description": "C++ struct skeleton"
  },
  "namespace": {
    "prefix": "ns",
    "body": ["namespace ${1:name} {", "", "${2}", "", "} // namespace ${1:name}"],
    "description": "C++ namespace block"
  },
  "CMake skeleton": {
    "prefix": "cmake",
    "body": [
      "cmake_minimum_required(VERSION 3.24)",
      "project(${1:project_name} LANGUAGES CXX)",
      "",
      "set(CMAKE_CXX_STANDARD 20)",
      "set(CMAKE_CXX_STANDARD_REQUIRED ON)",
      "set(CMAKE_EXPORT_COMPILE_COMMANDS ON)",
      "",
      "add_executable(${1:project_name} src/main.cpp)"
    ],
    "description": "CMakeLists.txt skeleton"
  },
  "test": {
    "prefix": "gtest",
    "body": ["#include <gtest/gtest.h>", "", "TEST(${1:Suite}, ${2:Case}) {", "    ${3:EXPECT_TRUE(true);}", "}"],
    "description": "GoogleTest test"
  }
}
