{
  "main": {
    "prefix": "main",
    "body": ["fn main() {", "    ${1:println!(\"Hello, world!\");}", "}"],
    "description": "Rust main function"
  },
  "result function": {
    "prefix": "rfn",
    "body": [
      "fn ${1:name}() -> Result<${2:()}, ${3:Box<dyn std::error::Error>}> {",
      "    ${4:Ok(())}",
      "}"
    ],
    "description": "Function returning Result"
  },
  "test": {
    "prefix": "test",
    "body": ["#[test]", "fn ${1:name}() {", "    ${2:assert!(true);}", "}"],
    "description": "Rust test"
  },
  "module tests": {
    "prefix": "modtest",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "    use super::*;",
      "",
      "    #[test]",
      "    fn ${1:name}() {",
      "        ${2:assert!(true);}",
      "    }",
      "}"
    ],
    "description": "Rust cfg(test) module"
  },
  "impl block": {
    "prefix": "impl",
    "body": ["impl ${1:Type} {", "    pub fn new(${2}) -> Self {", "        Self { ${3} }", "    }", "}"],
    "description": "Rust impl block"
  },
  "tokio main": {
    "prefix": "tmain",
    "body": [
      "#[tokio::main]",
      "async fn main() -> Result<(), Box<dyn std::error::Error>> {",
      "    ${1:Ok(())}",
      "}"
    ],
    "description": "Tokio async main"
  }
}
