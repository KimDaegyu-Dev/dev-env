{
  "name": "dev-env-control-plane",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @dev-env/server --filter @dev-env/dashboard dev",
    "dev:cli": "pnpm --filter @dev-env/cli dev",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write \"**/*.{md,yaml,yml}\" && biome format --write .",
    "format:check": "prettier --check \"**/*.{md,yaml,yml}\" && biome format .",
    "lint": "biome lint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "start": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.5.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
